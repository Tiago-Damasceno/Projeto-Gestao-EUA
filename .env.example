FLASK_ENV=development
FLASK_DEBUG=false
PORT=5000

# Projeto Supabase. A chave publica pode ser a publishable key nova ou a anon key legada.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLIC_KEY=

# SOMENTE NO BACKEND. Nunca inclua esta chave no HTML, JavaScript ou Vercel do frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Lista exata, separada por virgulas. Nao use * em producao.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Limites defensivos.
MAX_CONTENT_LENGTH=1048576
SUPABASE_TIMEOUT_SECONDS=8

# Twilio webhook verification. Keep the Auth Token on the backend only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Exact external backend origin used by Twilio, without a trailing slash.
# Example: https://api.example.com
PUBLIC_BASE_URL=

# Private authentication between this backend and n8n. Generate a long random value.
N8N_SHARED_SECRET=

# Optional production webhook that receives a small event notification after
# Twilio payload validation and durable storage. The message body stays in Supabase.
N8N_INBOUND_WEBHOOK_URL=

# OpenAI Responses API. Keep the API key on the backend only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
